          "IdTareaWorkflow",
          "IdRutaWorkflow",
          "IdExpediente",
          "IdTipoDocumento",
          "NombreTipoDocumento"
        ],
        "FieldOwnership": {
          "IdTipoDocumento": "FrontendOwned",
          "NombreTipoDocumento": "FrontendOwned",
          "ID_TIPODOCUMENTO": "FrontendOwned",
          "TIPODOCUMENTO": "FrontendOwned",
          "ID_AREA": "ProviderOwnedWhenSourceExists",
          "ID_SERIE": "ProviderOwnedWhenSourceExists",
          "ID_SUB_SERIE": "ProviderOwnedWhenSourceExists",
          "NOMBREAREA": "ProviderOwnedWhenSourceExists",
          "NOMBRESERIE": "ProviderOwnedWhenSourceExists",
          "NOMBRESUBSERIE": "ProviderOwnedWhenSourceExists"
        }
      }
    ]
  }
}
