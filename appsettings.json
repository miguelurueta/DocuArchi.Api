{
  "Jwt": {
    "Key": "",
    "Issuer": "DocuArchiCore",
    "Audience": "DocuArchiCore.Client",
    "Minutes": 20
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "MySqlConnection_DA": "",
    "MySqlConnection_WFR": "",
    "MySqlConnection_WF": "",
    "OdbcServices": "DSN=MembershipUsers;",
    "OdbcServicesGestor": "DSN=MembershipUsers;"
  },
  "PermissionTest": {
    "Secret": ""
  },
  "DbEngine": "mysql", // O el motor que estés usand
  "FeatureFlags": {
    "StorageEngineV2": true,
    "DELETE_STORAGE_ENGINE_V2": true,
    "RADICACION_TERMINATION_POLICY": false
  },
  "Radicacion": {
    "CamposFijos": {
      "Asunto": {
        "Alias": "Asunto",
        "MaxLength": 80,
        "Equivalentes": [ "ASUNTO" ]
      },
      "Anexos_Cor": {
        "Alias": "Anexos del Radicado",
        "MaxLength": 80,
        "Equivalentes": [ "ANEXOS_COR" ]
      }
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "https://localhost:5173",
      "http://localhost:5174",
      "https://localhost:5174"
    ]
  },
  "StoragePaths": {
    "Temp": "C:\\AppData\\DocuArchiApi\\temp",
    "Uploads": "C:\\AppData\\DocuArchiApi\\uploads",
    "Avatars": "C:\\AppData\\DocuArchiApi\\avatars",
    "Exports": "C:\\AppData\\DocuArchiApi\\exports",
    "Logs": "C:\\AppData\\DocuArchiApi\\logs"
  },
  "RuntimePaths": {
    "Root": "C:\\AppData\\DocuArchiApi",
    "DataProtectionKeys": "C:\\AppData\\DocuArchiApi\\dataprotection-keys"
  },
  "DataProtection": {
    "KeysPath": "C:\\AppData\\DocuArchiApi\\dataprotection-keys"
  },
  "WorkflowTermination": {
    "ManagedDestinationPreviewToken": {
      "SchemaVersion": 1,
      "Purpose": "DocuArchi.Workflow.ManagedDestinationPreview.v1",
      "TimeToLive": "00:05:00",
      "SharedKeyRingConfirmed": true
    }
  },
  "StorageUpload": {
    "MaxFileSizeBytes": 32212254720,
    "ChunkSizeBytes": 10485760,
    "AllowedExtensions": [ ".pdf", ".tif", ".tiff", ".jpg", ".jpeg", ".png", ".bmp" ],
    "TtlMinutes": 1440,
    "CleanupIntervalMinutes": 60
  },
  "StorageMetadata": {
    "CacheTtlMinutes": 30,
    "ValidatePhysicalSchema": false
  },
  "StorageEngine": {
    "FolderPolicy": {
      "MaxPaginasPorCarpeta": 700,
      "MaxNumeroCarpeta": 99999,
      "WarnNumeroCarpetaDesde": 90000
    }
  },
  "DocumentProcessing": {
    "OcrWorker": {
      "Enabled": false,
      "DefaultDbAlias": "DA",
      "WorkerUser": "ocr-worker",
      "PollIntervalSeconds": 10,
      "MaxBatchSize": 1
    },
    "OfficeWorker": {
      "Enabled": false,
      "DefaultDbAlias": "DA",
      "WorkerUser": "office-worker",
      "PollIntervalSeconds": 10,
      "MaxBatchSize": 1
    }
  },
  "RespuestaHistoricalContext": {
    "DocumentExtraction": {
      "Ocr": {
        "Enabled": true,
        "Provider": "TesseractLocal",
        "TesseractExecutablePath": "C:\\Program Files\\Tesseract-OCR\\tesseract.exe",
        "OcrMyPdfExecutablePath": "C:\\Python314\\Scripts\\ocrmypdf.exe",
        "GhostscriptExecutablePath": "C:\\Program Files\\gs\\gs10.07.1\\bin\\gswin64c.exe",
        "Languages": "spa+eng",
        "ArtifactsRootPath": "App_Data/AgentContext/ContextoHistorico/OcrArtifacts",
        "ArtifactStorage": {
          "Provider": "FileSystem",
          "RootKey": "OCR_ARTIFACTS",
          "RootPath": "",
          "RelativeBasePath": "OCR",
          "CreateDirectories": true,
          "WriteManifest": true
        },
        "TextChunking": {
          "Enabled": true,
          "MaxCharsPerChunk": 4000,
          "OverlapChars": 0
        },
        "SyncExecution": {
          "AllowSynchronousExecution": true,
          "MaxSyncFileBytes": 1048576,
          "MaxSyncDurationSeconds": 120
        },
        "TimeoutSeconds": 120,
        "MinMeanConfidence": 60,
        "MinTextLength": 80,
        "OcrMyPdfJobs": 2,
        "OcrMyPdfOptimize": 1,
        "OcrMyPdfDeskew": true,
        "OcrMyPdfForceOcr": true,
        "OcrMyPdfRedoOcr": true,
        "OcrMyPdfSkipText": true,
        "KeepArtifactsOnSuccess": false,
        "KeepArtifactsOnFailure": true
      }
    }
  },
  "StorageCabinetIndexProviders": {
    "Providers": [
      {
        "ProviderKey": "RADICACION",
        "ProviderName": "RADICACION",
        "ProviderVersion": "1.0.0",
        "SourceModule": "RADICACION",
        "AllowNullPayload": false,
        "AllowedProperties": [
          "ModoResolucion",
          "IdDocumentoOrigen",
          "NombreGabineteOrigen",
          "IdImagenOrigen",
          "ProveedorExterno",
          "proveedorExterno",
          "MatriculaSII",
          "matriculaSii",
          "RadicadoExterno",
          "radicadoExterno"
