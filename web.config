<?xml version="1.0" encoding="utf-8"?>
  <configuration>
    <location path="." inheritInChildApplications="false">
      <system.webServer>
        <modules>
          <remove name="WebDAVModule" />
        </modules>
        <handlers>
          <remove name="WebDAV" />
          <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
        </handlers>
        <aspNetCore processPath="dotnet" arguments=".\DocuArchi.Api.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
          <environmentVariables>
            <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />

            <environmentVariable name="ConnectionStrings__MySqlConnection_DA" value="server=localhost;database=docuarchi;uid=root;pwd=5840;Pooling=true;Min Pool Size=5;Max Pool Size=50;" />
            <environmentVariable name="ConnectionStrings__MySqlConnection_WFR" value="server=localhost;database=workflowdocument;uid=root;pwd=5840;Pooling=true;Min Pool Size=5;Max Pool Size=50;" />
            <environmentVariable name="ConnectionStrings__MySqlConnection_WF" value="server=localhost;database=workflowtconta;uid=root;pwd=5840;Pooling=true;Min Pool Size=5;Max Pool Size=50;" />

            <environmentVariable name="Jwt__Key" value="DocuArchiCore_JWT_Key_2026_Super_Segura_123456" />
            <environmentVariable name="Jwt__Issuer" value="DocuArchiCore" />
            <environmentVariable name="Jwt__Audience" value="DocuArchiCore.Client" />

            <environmentVariable name="Cors__AllowedOrigins__0" value="http://localhost:5174" />
            <environmentVariable name="Cors__AllowedOrigins__2" value="http://localhost:5173" />
            <environmentVariable name="Cors__AllowedOrigins__1" value="https://docuarchi.local" />

            <environmentVariable name="StoragePaths__Temp" value="C:\AppData\DocuArchiApi\temp" />
            <environmentVariable name="StoragePaths__Uploads" value="C:\AppData\DocuArchiApi\uploads" />
            <environmentVariable name="StoragePaths__Avatars" value="C:\AppData\DocuArchiApi\avatars" />
            <environmentVariable name="StoragePaths__Exports" value="C:\AppData\DocuArchiApi\exports" />
            <environmentVariable name="StoragePaths__Logs" value="C:\AppData\DocuArchiApi\logs" />
            <environmentVariable name="RuntimePaths__Root" value="C:\AppData\DocuArchiApi" />
            <environmentVariable name="RuntimePaths__DataProtectionKeys" value="C:\AppData\DocuArchiApi\dataprotection-keys" />
            <environmentVariable name="DataProtection__KeysPath" value="C:\AppData\DocuArchiApi\dataprotection-keys" />

            <environmentVariable name="DocumentProcessing__OcrWorker__Enabled" value="false" />
            <environmentVariable name="DocumentProcessing__OcrWorker__DefaultDbAlias" value="DA" />
            <environmentVariable name="DocumentProcessing__OcrWorker__WorkerUser" value="ocr-worker" />
            <environmentVariable name="DocumentProcessing__OcrWorker__PollIntervalSeconds" value="10" />
            <environmentVariable name="DocumentProcessing__OcrWorker__MaxBatchSize" value="1" />
            <environmentVariable name="DocumentProcessing__OfficeWorker__Enabled" value="false" />
            <environmentVariable name="DocumentProcessing__OfficeWorker__DefaultDbAlias" value="DA" />
            <environmentVariable name="DocumentProcessing__OfficeWorker__WorkerUser" value="office-worker" />
            <environmentVariable name="DocumentProcessing__OfficeWorker__PollIntervalSeconds" value="10" />
            <environmentVariable name="DocumentProcessing__OfficeWorker__MaxBatchSize" value="1" />

            <environmentVariable name="RespuestaHistoricalContext__DocumentExtraction__Ocr__Enabled" value="true" />
            <environmentVariable name="RespuestaHistoricalContext__DocumentExtraction__Ocr__Provider" value="TesseractLocal" />
            <environmentVariable name="RespuestaHistoricalContext__DocumentExtraction__Ocr__TesseractExecutablePath" value="C:\Program Files\Tesseract-OCR\tesseract.exe" />
            <environmentVariable name="RespuestaHistoricalContext__DocumentExtraction__Ocr__OcrMyPdfExecutablePath" value="C:\Python314\Scripts\ocrmypdf.exe" />
            <environmentVariable name="RespuestaHistoricalContext__DocumentExtraction__Ocr__GhostscriptExecutablePath" value="C:\Program Files\gs\gs10.07.1\bin\gswin64c.exe" />
            <environmentVariable name="RespuestaHistoricalContext__DocumentExtraction__Ocr__Languages" value="spa+eng" />
            <environmentVariable name="RespuestaHistoricalContext__DocumentExtraction__Ocr__ArtifactsRootPath" value="C:\AppData\DocuArchiApi\ocr-artifacts" />
            <environmentVariable name="RespuestaHistoricalContext__DocumentExtraction__Ocr__ArtifactStorage__Provider" value="FileSystem" />
            <environmentVariable name="RespuestaHistoricalContext__DocumentExtraction__Ocr__ArtifactStorage__RootKey" value="OCR_ARTIFACTS" />
            <environmentVariable name="RespuestaHistoricalContext__DocumentExtraction__Ocr__ArtifactStorage__RootPath" value="C:\AppData\DocuArchiApi\ocr-artifacts" />
            <environmentVariable name="RespuestaHistoricalContext__DocumentExtraction__Ocr__ArtifactStorage__RelativeBasePath" value="OCR" />
            <environmentVariable name="RespuestaHistoricalContext__DocumentExtraction__Ocr__ArtifactStorage__CreateDirectories" value="true" />
            <environmentVariable name="RespuestaHistoricalContext__DocumentExtraction__Ocr__ArtifactStorage__WriteManifest" value="true" />
            <environmentVariable name="RespuestaHistoricalContext__DocumentExtraction__Ocr__TextChunking__Enabled" value="true" />
            <environmentVariable name="RespuestaHistoricalContext__DocumentExtraction__Ocr__TextChunking__MaxCharsPerChunk" value="4000" />
            <environmentVariable name="RespuestaHistoricalContext__DocumentExtraction__Ocr__TextChunking__OverlapChars" value="0" />
            <environmentVariable name="RespuestaHistoricalContext__DocumentExtraction__Ocr__SyncExecution__AllowSynchronousExecution" value="true" />
            <environmentVariable name="RespuestaHistoricalContext__DocumentExtraction__Ocr__SyncExecution__MaxSyncFileBytes" value="1048576" />
            <environmentVariable name="RespuestaHistoricalContext__DocumentExtraction__Ocr__SyncExecution__MaxSyncDurationSeconds" value="120" />
            <environmentVariable name="RespuestaHistoricalContext__DocumentExtraction__Ocr__TimeoutSeconds" value="120" />
            <environmentVariable name="RespuestaHistoricalContext__DocumentExtraction__Ocr__MinMeanConfidence" value="60" />
            <environmentVariable name="RespuestaHistoricalContext__DocumentExtraction__Ocr__MinTextLength" value="80" />
            <environmentVariable name="RespuestaHistoricalContext__DocumentExtraction__Ocr__OcrMyPdfJobs" value="2" />
            <environmentVariable name="RespuestaHistoricalContext__DocumentExtraction__Ocr__OcrMyPdfOptimize" value="1" />
            <environmentVariable name="RespuestaHistoricalContext__DocumentExtraction__Ocr__OcrMyPdfDeskew" value="true" />
            <environmentVariable name="RespuestaHistoricalContext__DocumentExtraction__Ocr__OcrMyPdfForceOcr" value="true" />
            <environmentVariable name="RespuestaHistoricalContext__DocumentExtraction__Ocr__OcrMyPdfRedoOcr" value="true" />
            <environmentVariable name="RespuestaHistoricalContext__DocumentExtraction__Ocr__OcrMyPdfSkipText" value="true" />
            <environmentVariable name="RespuestaHistoricalContext__DocumentExtraction__Ocr__KeepArtifactsOnSuccess" value="false" />
            <environmentVariable name="RespuestaHistoricalContext__DocumentExtraction__Ocr__KeepArtifactsOnFailure" value="true" />

            <environmentVariable name="RespuestaHistoricalContext__DocumentExtraction__Office__EnableDocxExtraction" value="true" />
            <environmentVariable name="RespuestaHistoricalContext__DocumentExtraction__Office__EnableXlsxExtraction" value="true" />
            <environmentVariable name="RespuestaHistoricalContext__DocumentExtraction__Office__EnableLegacyDocConversion" value="false" />
            <environmentVariable name="RespuestaHistoricalContext__DocumentExtraction__Office__LibreOfficeExecutablePath" value="" />
            <environmentVariable name="RespuestaHistoricalContext__DocumentExtraction__Office__ArtifactsRoot" value="C:\AppData\DocuArchiApi\office-artifacts" />
            <environmentVariable name="RespuestaHistoricalContext__DocumentExtraction__Office__ConversionTimeoutSeconds" value="60" />
            <environmentVariable name="RespuestaHistoricalContext__DocumentExtraction__Office__MaxConvertedFileBytes" value="10485760" />
            <environmentVariable name="RespuestaHistoricalContext__DocumentExtraction__Office__CleanupArtifacts" value="true" />
            <environmentVariable name="RespuestaHistoricalContext__DocumentExtraction__Office__ArtifactStorage__Provider" value="FileSystem" />
            <environmentVariable name="RespuestaHistoricalContext__DocumentExtraction__Office__ArtifactStorage__RootKey" value="OFFICE_ARTIFACTS" />
            <environmentVariable name="RespuestaHistoricalContext__DocumentExtraction__Office__ArtifactStorage__RootPath" value="C:\AppData\DocuArchiApi\office-artifacts" />
            <environmentVariable name="RespuestaHistoricalContext__DocumentExtraction__Office__ArtifactStorage__RelativeBasePath" value="OFFICE" />
            <environmentVariable name="RespuestaHistoricalContext__DocumentExtraction__Office__ArtifactStorage__CreateDirectories" value="true" />
            <environmentVariable name="RespuestaHistoricalContext__DocumentExtraction__Office__TextChunking__Enabled" value="true" />
            <environmentVariable name="RespuestaHistoricalContext__DocumentExtraction__Office__TextChunking__MaxCharsPerChunk" value="4000" />
            <environmentVariable name="RespuestaHistoricalContext__DocumentExtraction__Office__TextChunking__OverlapChars" value="200" />
            <environmentVariable name="RespuestaHistoricalContext__DocumentExtraction__Office__PdfaValidation__ExecutablePath" value="" />
            <environmentVariable name="RespuestaHistoricalContext__DocumentExtraction__Office__PdfaValidation__TimeoutSeconds" value="60" />

            <environmentVariable name="ContextoHistorico__DocumentExtraction__Office__EnableDocxExtraction" value="true" />
            <environmentVariable name="ContextoHistorico__DocumentExtraction__Office__EnableXlsxExtraction" value="true" />
            <environmentVariable name="ContextoHistorico__DocumentExtraction__Office__EnableLegacyDocConversion" value="false" />
            <environmentVariable name="ContextoHistorico__DocumentExtraction__Office__LibreOfficeExecutablePath" value="" />
            <environmentVariable name="ContextoHistorico__DocumentExtraction__Office__ArtifactsRoot" value="C:\AppData\DocuArchiApi\office-artifacts" />
            <environmentVariable name="ContextoHistorico__DocumentExtraction__Office__ConversionTimeoutSeconds" value="60" />
            <environmentVariable name="ContextoHistorico__DocumentExtraction__Office__MaxConvertedFileBytes" value="10485760" />
            <environmentVariable name="ContextoHistorico__DocumentExtraction__Office__CleanupArtifacts" value="true" />
            <environmentVariable name="ContextoHistorico__DocumentExtraction__Office__ArtifactStorage__Provider" value="FileSystem" />
            <environmentVariable name="ContextoHistorico__DocumentExtraction__Office__ArtifactStorage__RootKey" value="OFFICE_ARTIFACTS" />
            <environmentVariable name="ContextoHistorico__DocumentExtraction__Office__ArtifactStorage__RootPath" value="C:\AppData\DocuArchiApi\office-artifacts" />
            <environmentVariable name="ContextoHistorico__DocumentExtraction__Office__ArtifactStorage__RelativeBasePath" value="OFFICE" />
            <environmentVariable name="ContextoHistorico__DocumentExtraction__Office__ArtifactStorage__CreateDirectories" value="true" />
            <environmentVariable name="ContextoHistorico__DocumentExtraction__Office__TextChunking__Enabled" value="true" />
            <environmentVariable name="ContextoHistorico__DocumentExtraction__Office__TextChunking__MaxCharsPerChunk" value="4000" />
            <environmentVariable name="ContextoHistorico__DocumentExtraction__Office__TextChunking__OverlapChars" value="200" />
            <environmentVariable name="ContextoHistorico__DocumentExtraction__Office__PdfaValidation__ExecutablePath" value="" />
            <environmentVariable name="ContextoHistorico__DocumentExtraction__Office__PdfaValidation__TimeoutSeconds" value="60" />
          </environmentVariables>
        </aspNetCore>
      </system.webServer>
    </location>
  </configuration>
